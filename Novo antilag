    if CFG.TelaEsticada then
        C.CFrame = C.CFrame * CFrame.new(0, 0, 0, 1, 0, 0, 0, CFG.Esticada, 0, 0, 0, 1)
    end
end)

-- ═══ LOOPS DO HUD ═══
local fpsHistory = {}
RS.RenderStepped:Connect(function()
    if not CFG.HUD then return end
    local now = tick()
    table.insert(fpsHistory, now)
    while #fpsHistory > 0 and fpsHistory[1] < now - 1 do
        table.remove(fpsHistory, 1)
    end
    local fps = #fpsHistory
    if math.floor(now * 10) % 3 == 0 then
        fpsLbl.Text = "FPS " .. fps
        if fps >= 50 then
            fpsLbl.TextColor3 = COR.green
        elseif fps >= 30 then
            fpsLbl.TextColor3 = Color3.fromRGB(255, 200, 60)
        else
            fpsLbl.TextColor3 = COR.red
        end
    end
end)

task.spawn(function()
    while task.wait(1) do
        if not CFG.HUD then continue end
        local ok, ping = pcall(function() return math.floor(P:GetNetworkPing() * 1000) end)
        if ok and ping then
            pingLbl.Text = "PING " .. ping .. "ms"
            if ping < 80 then
                pingLbl.TextColor3 = COR.purple
            elseif ping < 160 then
                pingLbl.TextColor3 = Color3.fromRGB(255, 200, 60)
            else
                pingLbl.TextColor3 = COR.red
            end
        end
    end
end)

