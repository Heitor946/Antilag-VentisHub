-- LÓGICA DO ANTILAG
-- ═══════════════════════════════════════
local BACKUP = {}
local PROCESSADOS = {}
local Ativo = false

local CLASSES = {
    Decal = 1, Texture = 1, MeshPart = 1, SpecialMesh = 1,
    SurfaceAppearance = 1, Sky = 1, Clouds = 1,
    Shirt = 1, Pants = 1, ShirtGraphic = 1,
    ParticleEmitter = 1, Trail = 1, Beam = 1,
    Fire = 1, Smoke = 1, Sparkles = 1,
    PointLight = 1, SpotLight = 1, SurfaceLight = 1,
    Atmosphere = 1, BloomEffect = 1, BlurEffect = 1,
    ColorCorrectionEffect = 1, SunRaysEffect = 1, DepthOfFieldEffect = 1,
}

local function backup(obj, prop)
    if not obj then return end
    if not BACKUP[obj] then BACKUP[obj] = {} end
    if BACKUP[obj][prop] == nil then
        local ok, val = pcall(function() return obj[prop] end)
        if ok then BACKUP[obj][prop] = val end
    end
end

local function setP(obj, prop, value)
    backup(obj, prop)
    pcall(function() obj[prop] = value end)
end

local function otimizar(o)
    if not o or not o.Parent then return end
    if PROCESSADOS[o] then return end
    PROCESSADOS[o] = true

    local c = o.ClassName
    pcall(function()
        if c == "Decal" or c == "Texture" then
            setP(o, "Texture", ""); setP(o, "Transparency", 1)
        elseif c == "MeshPart" then
            setP(o, "TextureID", ""); setP(o, "Material", Enum.Material.SmoothPlastic)
            setP(o, "Reflectance", 0); setP(o, "CastShadow", false)
        elseif c == "SpecialMesh" then
            setP(o, "TextureId", ""); setP(o, "MeshId", "")
        elseif c == "SurfaceAppearance" then
            setP(o, "ColorMap", ""); setP(o, "NormalMap", "")
            setP(o, "RoughnessMap", ""); setP(o, "MetalnessMap", "")
        elseif c == "Sky" then
            setP(o, "SkyboxBk", ""); setP(o, "SkyboxDn", ""); setP(o, "SkyboxFt", "")
            setP(o, "SkyboxLf", ""); setP(o, "SkyboxRt", ""); setP(o, "SkyboxUp", "")
            setP(o, "StarCount", 0); setP(o, "SunAngularSize", 0); setP(o, "MoonAngularSize", 0)
        elseif c == "Clouds" then
            setP(o, "Enabled", false)
        elseif c == "ParticleEmitter" or c == "Trail" or c == "Beam" then
            setP(o, "Texture", ""); setP(o, "Enabled", false)
        elseif c == "Fire" or c == "Smoke" or c == "Sparkles" then
            setP(o, "Enabled", false)
        elseif c == "PointLight" or c == "SpotLight" or c == "SurfaceLight" then
            setP(o, "Enabled", false)
        elseif c == "Atmosphere" then
            setP(o, "Density", 0); setP(o, "Haze", 0); setP(o, "Glare", 0)
        elseif c == "BloomEffect" or c == "SunRaysEffect" or c == "ColorCorrectionEffect" or c == "DepthOfFieldEffect" or c == "BlurEffect" then
            setP(o, "Enabled", false)
        elseif o:IsA("BasePart") then
            setP(o, "CastShadow", false); setP(o, "Reflectance", 0)
            if o.Material ~= Enum.Material.SmoothPlastic and o.Material ~= Enum.Material.Plastic then
                setP(o, "Material", Enum.Material.SmoothPlastic)
            end
        end
    end)
end

local function aplicarGlobal()
    pcall(function() setP(US.GameSettings, "GraphicsQuality", Enum.QualityLevel.Level1) end)
    pcall(function() if setfpscap then setfpscap(240) end end)
    pcall(function()
        setP(L, "GlobalShadows", false); setP(L, "ShadowSoftness", 0); setP(L, "Brightness", 2)
        setP(L, "Ambient", Color3.fromRGB(90, 90, 90)); setP(L, "OutdoorAmbient", Color3.fromRGB(110, 110, 110))
        setP(L, "EnvironmentDiffuseScale", 0); setP(L, "EnvironmentSpecularScale", 0)
        setP(L, "FogStart", 9e9); setP(L, "FogEnd", 9e9)
    end)
    pcall(function()
        local tm = w:FindFirstChildOfClass("Terrain")
        if tm then
            setP(tm, "WaterWaveSize", 0); setP(tm, "WaterWaveSpeed", 0)
            setP(tm, "WaterReflectance", 0); setP(tm, "WaterTransparency", 1)
            setP(tm, "Decoration", false)
        end
    end)
end

function ligarAntiLag()
    if Ativo then return end
    Ativo = true
    CFG.AntiLag = true
    PROCESSADOS = {}

    task.spawn(function()
        local n = 0
        local roots = {w, P:FindFirstChild("PlayerGui"), L, game:GetService("ReplicatedStorage"), game:GetService("StarterGui")}
        for _, root in ipairs(roots) do
            if root and Ativo then
                for _, o in ipairs(root:GetDescendants()) do
                    if not Ativo then return end
                    otimizar(o)
                    n = n + 1
                    if n % 300 == 0 then task.wait() end
                end
            end
        end
        if Ativo then
            aplicarGlobal()
            print("✅ Antilag ON — " .. n .. " objetos processados")
        end
    end)
end

function desligarAntiLag()
    Ativo = false
    CFG.AntiLag = false

    local count = 0
    for obj, props in pairs(BACKUP) do
        if obj and obj.Parent then
            for prop, original in pairs(props) do
                pcall(function() obj[prop] = original end)
                count = count + 1
            end
        end
    end
    BACKUP = {}
    PROCESSADOS = {}

    pcall(function() US.GameSettings.GraphicsQuality = Enum.QualityLevel.Automatic end)
    pcall(function()
        L.GlobalShadows = true
        L.ShadowSoftness = 0.5
        L.Brightness = 2
        L.Ambient = Color3.fromRGB(70, 70, 70)
        L.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
        L.EnvironmentDiffuseScale = 1
        L.EnvironmentSpecularScale = 1
        L.FogStart = 100
        L.FogEnd = 10000
    end)
    pcall(function()
        local tm = w:FindFirstChildOfClass("Terrain")
        if tm then
            tm.WaterWaveSize = 0.15
            tm.WaterWaveSpeed = 10
            tm.WaterReflectance = 0.05
            tm.WaterTransparency = 0.7
            tm.Decoration = true
        end
    end)

    print("🔄 Antilag OFF — " .. count .. " propriedades restauradas")
end

