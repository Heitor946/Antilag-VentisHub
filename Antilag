local function setMasterState(newState)
    if busy then return end
    on = newState

    if on then
        TweenService:Create(toggleHolder, TWEEN_FAST, {BackgroundColor3 = THEME.accent}):Play()
        if not toggleHolder:FindFirstChildOfClass("UIGradient") then
            gradient(toggleHolder, THEME.accent, THEME.accent2, 45)
        end
        TweenService:Create(toggleKnob, TWEEN_FAST, {Position = UDim2.new(1, -19, 0.5, -8)}):Play()
        toggleText.Text = "ON"
        motionBlur.Enabled = categories.motion_blur
        applyAll()
        print("⚡ VENTIS: ON")
    else
        TweenService:Create(toggleHolder, TWEEN_FAST, {BackgroundColor3 = THEME.bgRow}):Play()
        local g = toggleHolder:FindFirstChildOfClass("UIGradient")
        if g then g:Destroy() end
        TweenService:Create(toggleKnob, TWEEN_FAST, {Position = UDim2.new(0, 3, 0.5, -8)}):Play()
        toggleText.Text = "OFF"
        motionBlur.Enabled = false
        motionBlur.Size = 0
        restore()
        print("⚡ VENTIS: OFF")
    end
end

toggleBtn.MouseButton1Click:Connect(function() setMasterState(not on) end)

