local frameTimes = {}
local function fpsColor(fps)
    if fps >= 50 then return THEME.success
    elseif fps >= 30 then return THEME.warn
    else return THEME.danger end
end

RunService.RenderStepped:Connect(function()
    local now = tick()
    table.insert(frameTimes, now)
    while #frameTimes > 0 and frameTimes[1] < now - 1 do
        table.remove(frameTimes, 1)
    end
    local fps = #frameTimes
    fpsValue.Text = tostring(fps)
    local col = fpsColor(fps)
    fpsValue.TextColor3 = col
    fpsBar.BackgroundColor3 = col
    local pct = math.clamp(fps / 120, 0, 1)
    TweenService:Create(fpsBar, TWEEN_FAST, {Size = UDim2.new(pct, 0, 1, 0)}):Play()
end)

task.spawn(function()
    while true do
        local ok, ping = pcall(function()
            return math.floor(player:GetNetworkPing() * 1000)
        end)
        if ok and ping then
            pingValue.Text = ping .. " ms"
            if ping < 80 then pingValue.TextColor3 = THEME.success
            elseif ping < 160 then pingValue.TextColor3 = THEME.warn
            else pingValue.TextColor3 = THEME.danger end
        end
        task.wait(1)
    end
end)

