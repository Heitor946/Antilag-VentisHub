local function bevel(parent, mode, thickness)
    thickness = thickness or 1
    local hi, lo
    if mode == "raised" then hi, lo = THEME.bevelHi, THEME.bevelLo
    else                     hi, lo = THEME.bevelLo, THEME.bevelHi end

    local top = Instance.new("Frame")
    top.Size = UDim2.new(1, 0, 0, thickness)
    top.BackgroundColor3 = hi
    top.BorderSizePixel = 0
    top.ZIndex = 2
    top.Parent = parent

    local left = Instance.new("Frame")
    left.Size = UDim2.new(0, thickness, 1, 0)
    left.BackgroundColor3 = hi
    left.BorderSizePixel = 0
    left.ZIndex = 2
    left.Parent = parent

    local bottom = Instance.new("Frame")
    bottom.Size = UDim2.new(1, 0, 0, thickness)
    bottom.Position = UDim2.new(0, 0, 1, -thickness)
    bottom.BackgroundColor3 = lo
    bottom.BorderSizePixel = 0
    bottom.ZIndex = 2
    bottom.Parent = parent

    local right = Instance.new("Frame")
    right.Size = UDim2.new(0, thickness, 1, 0)
    right.Position = UDim2.new(1, -thickness, 0, 0)
    right.BackgroundColor3 = lo
    right.BorderSizePixel = 0
    right.ZIndex = 2
    right.Parent = parent

    return {top=top, left=left, bottom=bottom, right=right}
end

local function stroke(parent, color, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color or THEME.border
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    return s
end

local function retroButton(parent, size, position, text, colorOverride)
    local btn = Instance.new("TextButton")
    btn.Size = size
    btn.Position = position
    btn.BackgroundColor3 = colorOverride or THEME.face
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = false
    btn.Text = ""
    btn.Parent = parent

    stroke(btn, THEME.border, 2)
    local bev = bevel(btn, "raised", 1)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = THEME.text
    label.Font = Enum.Font.Code
    label.TextSize = 13
    label.ZIndex = 3
    label.Parent = btn

    btn.MouseButton1Down:Connect(function()
        btn.BackgroundColor3 = THEME.faceDark
        bev.top.BackgroundColor3 = THEME.bevelLo
        bev.left.BackgroundColor3 = THEME.bevelLo
        bev.bottom.BackgroundColor3 = THEME.bevelHi
        bev.right.BackgroundColor3 = THEME.bevelHi
    end)
    local function restore()
        btn.BackgroundColor3 = colorOverride or THEME.face
        bev.top.BackgroundColor3 = THEME.bevelHi
        bev.left.BackgroundColor3 = THEME.bevelHi
        bev.bottom.BackgroundColor3 = THEME.bevelLo
        bev.right.BackgroundColor3 = THEME.bevelLo
    end
    btn.MouseButton1Up:Connect(restore)
    btn.MouseLeave:Connect(restore)

    return btn, label
end

