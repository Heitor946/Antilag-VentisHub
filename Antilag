local function setMasterState(newState)
    if busy then return end
    on = newState

    if on then
        masterLbl.Text = "ENABLED"
        masterLbl.TextColor3 = THEME.accentGreenD
        masterBtn.BackgroundColor3 = Color3.fromRGB(200, 230, 200)
        motionBlur.Enabled = categories.motion_blur
        applyAll()
        print("⚡ VENTIS: ON")
    else
        masterLbl.Text = "DISABLED"
        masterLbl.TextColor3 = THEME.danger
        masterBtn.BackgroundColor3 = Color3.fromRGB(240, 210, 210)
        motionBlur.Enabled = false
        motionBlur.Size = 0
        restore()
        print("⚡ VENTIS: OFF")
    end
end

masterBtn.MouseButton1Click:Connect(function() setMasterState(not on) end)

