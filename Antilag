-- drag da orb com clique vs arrasto
do
    local dragging, dragStart, startPos, moved
    local MOVE_THRESHOLD = 6

    orb.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            dragStart = input.Position
            startPos = orb.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UserInput.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            if math.abs(delta.X) > MOVE_THRESHOLD or math.abs(delta.Y) > MOVE_THRESHOLD then
                moved = true
            end
            if moved then
                orb.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end
    end)

    orb.MouseButton1Click:Connect(function()
        if moved then return end
        orb.Visible = false
        hub.Visible = true
        hub.Size = UDim2.new(0, 0, 0, 0)
        TweenService:Create(hub, TWEEN_BACK, {
            Size = UDim2.new(0, HUB_W, 0, HUB_H)
        }):Play()
    end)
end

