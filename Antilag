    ultra = false,
    textures = false,
    particles = false,
    lights = false,
    shadows = false,
    effects = false,
    water = false,
    materials = false,
    fps = true
}

local saved = {}

--------------------------------------------------------
-- SALVAR
--------------------------------------------------------

local function save(obj, property)

    saved[obj] = saved[obj] or {}

    if saved[obj][property] == nil then

        local ok, value = pcall(function()
            return obj[property]
        end)

        if ok then
            saved[obj][property] = value
        end

    end
end

--------------------------------------------------------
-- TEXTURAS
--------------------------------------------------------

local function removeTextures(obj)

    if obj:IsA("Decal") or obj:IsA("Texture") then

        save(obj, "Transparency")
        obj.Transparency = 1

    elseif obj:IsA("MeshPart") then

        save(obj, "TextureID")
        obj.TextureID = ""

    elseif obj:IsA("SpecialMesh") then

        save(obj, "TextureId")
        obj.TextureId = ""

    end
end

--------------------------------------------------------
-- PARTÍCULAS
--------------------------------------------------------

local function removeParticles(obj)

    if obj:IsA("ParticleEmitter")
        or obj:IsA("Trail")
        or obj:IsA("Beam")
        or obj:IsA("Fire")
        or obj:IsA("Smoke")
        or obj:IsA("Sparkles") then

        save(obj, "Enabled")
        obj.Enabled = false

    end
end

--------------------------------------------------------
-- LUZES
--------------------------------------------------------

local function removeLights(obj)

    if obj:IsA("PointLight")
        or obj:IsA("SpotLight")
        or obj:IsA("SurfaceLight") then

        save(obj, "Enabled")
        obj.Enabled = false

    end
end

--------------------------------------------------------
-- MATERIAIS
--------------------------------------------------------

local function lowMaterials(obj)

    if obj:IsA("BasePart") then

        save(obj, "Material")
        obj.Material = Enum.Material.SmoothPlastic

    end
end

--------------------------------------------------------
-- SOMBRAS
--------------------------------------------------------

local function shadowsOFF()

    save(Lighting, "GlobalShadows")
    Lighting.GlobalShadows = false

end

--------------------------------------------------------
-- FOG
--------------------------------------------------------

local function fogOFF()

    save(Lighting, "FogStart")
    save(Lighting, "FogEnd")

    Lighting.FogStart = 9e9
    Lighting.FogEnd = 9e9

end

--------------------------------------------------------
-- PÓS-EFEITOS
--------------------------------------------------------

local function effectsOFF()

    for _, obj in ipairs(Lighting:GetChildren()) do

        if obj:IsA("PostEffect") then

            save(obj, "Enabled")
            obj.Enabled = false

        elseif obj:IsA("Atmosphere") then

            save(obj, "Density")
            obj.Density = 0

        end

    end
end

--------------------------------------------------------
-- ÁGUA
--------------------------------------------------------

local function waterOFF()

    save(Terrain, "WaterWaveSize")
    save(Terrain, "WaterWaveSpeed")
    save(Terrain, "WaterReflectance")
    save(Terrain, "WaterTransparency")

    Terrain.WaterWaveSize = 0
    Terrain.WaterWaveSpeed = 0
    Terrain.WaterReflectance = 0
    Terrain.WaterTransparency = 1

end

--------------------------------------------------------
-- ULTRA FPS
--------------------------------------------------------

local function ultraFPS()

    shadowsOFF()
    fogOFF()
    effectsOFF()
    waterOFF()

    for _, obj in ipairs(workspace:GetDescendants()) do

        removeTextures(obj)
        removeParticles(obj)
        removeLights(obj)
        lowMaterials(obj)

    end

end

--------------------------------------------------------
-- RESTAURAR
--------------------------------------------------------

local function restoreAll()

    for obj, properties in pairs(saved) do

        if obj and obj.Parent then

            for property, value in pairs(properties) do

                pcall(function()
                    obj[property] = value
                end)

            end

        end

    end

    saved = {}

end

--------------------------------------------------------
