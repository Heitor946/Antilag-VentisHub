--======================================================
-- CHECKBOX + LINHAS DE CATEGORIA
--======================================================
local function makeCheckbox(parent, initial, callback)
    local box = Instance.new("TextButton")
    box.Size = UDim2.new(0, 16, 0, 16)
    box.BackgroundColor3 = THEME.faceLight
    box.Text = ""
    box.BorderSizePixel = 0
    box.AutoButtonColor = false
    box.ZIndex = 3
    box.Parent = parent
    stroke(box, THEME.border, 2)
    bevel(box, "sunken", 1)

    local check = Instance.new("TextLabel")
    check.Size = UDim2.new(1, 0, 1, 0)
    check.BackgroundTransparency = 1
    check.Text = "✔"
    check.TextColor3 = THEME.accentGreen
    check.TextSize = 14
    check.Font = Enum.Font.GothamBold
    check.ZIndex = 4
    check.Visible = initial
    check.Parent = box

    local state = initial

    box.MouseButton1Click:Connect(function()
        state = not state
        check.Visible = state
        callback(state)
    end)

    return box, check
end

