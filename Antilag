local function globalKill()
    if not on then return end

    if categories.graphics_quality then
        pcall(function()
            UserSettings.GameSettings.GraphicsQuality = Enum.QualityLevel.Level1
        end)
    end

    if categories.global_lighting then
        set(Lighting, "GlobalShadows", false, "global_lighting")
        set(Lighting, "ShadowSoftness", 0, "global_lighting")
        set(Lighting, "Brightness", 2, "global_lighting")
        set(Lighting, "Ambient", Color3.fromRGB(90, 90, 90), "global_lighting")
        set(Lighting, "OutdoorAmbient", Color3.fromRGB(110, 110, 110), "global_lighting")
        set(Lighting, "EnvironmentDiffuseScale", 0, "global_lighting")
        set(Lighting, "EnvironmentSpecularScale", 0, "global_lighting")
        set(Lighting, "FogStart", 9e9, "global_lighting")
        set(Lighting, "FogEnd", 9e9, "global_lighting")
    end

    if categories.water_terrain then
        local terrain = workspace:FindFirstChildOfClass("Terrain")
        if terrain then
            pcall(function()
                set(terrain, "WaterWaveSize", 0, "water_terrain")
                set(terrain, "WaterWaveSpeed", 0, "water_terrain")
                set(terrain, "WaterReflectance", 0, "water_terrain")
                set(terrain, "WaterTransparency", 1, "water_terrain")
                terrain.Decoration = false
            end)
        end
    end
end

--======================================================
-- LOCK LIGHTING
--======================================================

local lightingLock = false
local function lockLighting()
    if lightingLock then return end
    lightingLock = true
    Lighting:GetPropertyChangedSignal("Brightness"):Connect(function()
        if on and categories.global_lighting and Lighting.Brightness ~= 2 then
            set(Lighting, "Brightness", 2, "global_lighting")
        end
    end)
    Lighting:GetPropertyChangedSignal("Ambient"):Connect(function()
        if on and categories.global_lighting and Lighting.Ambient ~= Color3.fromRGB(90,90,90) then
            set(Lighting, "Ambient", Color3.fromRGB(90,90,90), "global_lighting")
        end
    end)
    Lighting:GetPropertyChangedSignal("OutdoorAmbient"):Connect(function()
        if on and categories.global_lighting and Lighting.OutdoorAmbient ~= Color3.fromRGB(110,110,110) then
            set(Lighting, "OutdoorAmbient", Color3.fromRGB(110,110,110), "global_lighting")
        end
    end)
end

--======================================================
-- APPLY ALL
--======================================================

local BATCH = 400

local function applyAll()
    if not on or busy then return end
    busy = true
    generation += 1
    local myGen = generation

    task.spawn(function()
        local roots = {
            workspace,
            playerGui,
            Lighting,
            game:GetService("ReplicatedStorage"),
            game:GetService("StarterGui"),
        }
        local count = 0
        for _, root in ipairs(roots) do
            if root then
                for _, obj in ipairs(root:GetDescendants()) do
                    if not on or myGen ~= generation then busy = false ; return end
                    kill(obj)
                    count += 1
                    if count % BATCH == 0 then task.wait() end
                end
            end
        end
        globalKill()
        lockLighting()
        busy = false
    end)
end

