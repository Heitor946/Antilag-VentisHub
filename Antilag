--======================================================
-- KILL
--======================================================

local function kill(obj)
    if not on or not obj or not obj.Parent then return end
    local c = obj.ClassName

    if c == "Decal" or c == "Texture" then
        if not categories.textures then return end
        set(obj, "Texture", "", "textures")
        set(obj, "Transparency", 1, "textures")
        return
    end
    if c == "MeshPart" then
        if categories.textures then set(obj, "TextureID", "", "textures") end
        if categories.shadows_material then
            set(obj, "Material", Enum.Material.SmoothPlastic, "shadows_material")
            set(obj, "Reflectance", 0, "shadows_material")
            set(obj, "CastShadow", false, "shadows_material")
        end
        return
    end
    if c == "SpecialMesh" then
        if not categories.textures then return end
        set(obj, "TextureId", "", "textures")
        set(obj, "MeshId", "", "textures")
        return
    end
    if c == "SurfaceAppearance" then
        if not categories.textures then return end
        set(obj, "ColorMap", "", "textures")
        set(obj, "NormalMap", "", "textures")
        set(obj, "RoughnessMap", "", "textures")
        set(obj, "MetalnessMap", "", "textures")
        return
    end
    if c == "SurfaceGui" then
        if not categories.gui_images then return end
        set(obj, "Enabled", false, "gui_images")
        return
    end
    if c == "ImageLabel" or c == "ImageButton" then
        if not categories.gui_images then return end
        set(obj, "ImageTransparency", 1, "gui_images")
        set(obj, "BackgroundTransparency", 1, "gui_images")
        return
    end
    if c == "Sky" then
        if not categories.sky_atmosphere then return end
        set(obj, "SkyboxBk", "", "sky_atmosphere") set(obj, "SkyboxDn", "", "sky_atmosphere")
        set(obj, "SkyboxFt", "", "sky_atmosphere") set(obj, "SkyboxLf", "", "sky_atmosphere")
        set(obj, "SkyboxRt", "", "sky_atmosphere") set(obj, "SkyboxUp", "", "sky_atmosphere")
        set(obj, "StarCount", 0, "sky_atmosphere")
        set(obj, "SunAngularSize", 0, "sky_atmosphere")
        set(obj, "MoonAngularSize", 0, "sky_atmosphere")
        return
    end
    if c == "Clouds" then
        if not categories.sky_atmosphere then return end
        set(obj, "Enabled", false, "sky_atmosphere")
        return
    end
    if c == "ParticleEmitter" or c == "Trail" or c == "Beam" then
        if not categories.particles then return end
        set(obj, "Texture", "", "particles")
        set(obj, "Enabled", false, "particles")
        return
    end
    if c == "Fire" or c == "Smoke" or c == "Sparkles" then
        if not categories.particles then return end
        set(obj, "Enabled", false, "particles")
        return
    end
    if c == "PointLight" or c == "SpotLight" or c == "SurfaceLight" then
        if not categories.lights then return end
        set(obj, "Enabled", false, "lights")
        return
    end
    if c == "Atmosphere" then
        if not categories.sky_atmosphere then return end
        set(obj, "Density", 0, "sky_atmosphere")
        set(obj, "Haze", 0, "sky_atmosphere")
        set(obj, "Glare", 0, "sky_atmosphere")
        return
    end
    if c == "BloomEffect" or c == "SunRaysEffect" or c == "ColorCorrectionEffect"
        or c == "DepthOfFieldEffect" then
        if not categories.post_effects then return end
        set(obj, "Enabled", false, "post_effects")
        return
    end
    if c == "BlurEffect" then
        if obj.Name ~= "VentisMotionBlur" then
            if not categories.post_effects then return end
            set(obj, "Enabled", false, "post_effects")
        end
        return
    end
    if obj:IsA("BasePart") then
        if not categories.shadows_material then return end
        set(obj, "CastShadow", false, "shadows_material")
        if obj.Material ~= Enum.Material.SmoothPlastic and obj.Material ~= Enum.Material.Plastic then
            set(obj, "Material", Enum.Material.SmoothPlastic, "shadows_material")
        end
        set(obj, "Reflectance", 0, "shadows_material")
    end
end

