local saved = {}

local function cleanupSaved()
    local removed = 0
    for obj in pairs(saved) do
        if not obj or not obj.Parent then
            saved[obj] = nil
            removed += 1
        end
    end
    return removed
end

--======================================================
-- SALVAR / RESTAURAR
--======================================================
local function save(obj, prop, category)
    local t = saved[obj]
    if not t then t = {} ; saved[obj] = t end
    if t[prop] == nil then
        local ok, v = pcall(function() return obj[prop] end)
        if ok then t[prop] = { value = v, category = category } end
    end
end

local function set(obj, prop, value, category)
    save(obj, prop, category)
    pcall(function() obj[prop] = value end)
end

local function restore()
    local count = 0
    for obj, props in pairs(saved) do
        if obj and obj.Parent then
            for prop, data in pairs(props) do
                pcall(function() obj[prop] = data.value end)
            end
            count += 1
        end
    end
    saved = {}
    print("⚡ VENTIS: " .. count .. " objeto(s) restaurado(s).")
end

local function restoreCategory(catName)
    local count = 0
    for obj, props in pairs(saved) do
        if obj and obj.Parent then
            for prop, data in pairs(props) do
                if data.category == catName then
                    pcall(function() obj[prop] = data.value end)
                    props[prop] = nil
                    count += 1
                end
            end
            if next(props) == nil then saved[obj] = nil end
        else
            saved[obj] = nil
        end
    end
    print("⚡ VENTIS: '" .. catName .. "' restaurada em " .. count .. " propriedade(s).")
end

