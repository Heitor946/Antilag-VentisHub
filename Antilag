local lastCFrame = workspace.CurrentCamera and workspace.CurrentCamera.CFrame or CFrame.new()
RunService.RenderStepped:Connect(function()
    local cam = workspace.CurrentCamera
    if not cam then return end
    if not on or not categories.motion_blur then
        lastCFrame = cam.CFrame
        return
    end
    local delta = (cam.CFrame.LookVector - lastCFrame.LookVector).Magnitude
    motionBlur.Size = math.clamp(delta * 10, 0, 6)
    lastCFrame = cam.CFrame
end)

