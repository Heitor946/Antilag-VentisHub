--======================================================
-- SWITCH COMPONENT
--======================================================

local function makeSwitch(parent, initial, callback)
    local pill = Instance.new("TextButton")
    pill.Size = UDim2.new(0, 34, 0, 18)
    pill.BackgroundColor3 = initial and THEME.accent or THEME.bgRow
    pill.Text = ""
    pill.BorderSizePixel = 0
    pill.AutoButtonColor = false
    pill.Parent = parent
    corner(pill, 9)

    local strokeObj, gradObj
    if initial then
        gradObj = gradient(pill, THEME.accent, THEME.accent2, 45)
    else
        strokeObj = stroke(pill, THEME.border, 1)
    end

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 14, 0, 14)
    knob.Position = initial and UDim2.new(0, 18, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
    knob.BackgroundColor3 = Color3.new(1,1,1)
    knob.BorderSizePixel = 0
    knob.Parent = pill
    corner(knob, 7)

    local state = initial

    local function apply(v)
        state = v
        if v then
            pill.BackgroundColor3 = THEME.accent
            if not gradObj then gradObj = gradient(pill, THEME.accent, THEME.accent2, 45) end
            if strokeObj then strokeObj:Destroy() ; strokeObj = nil end
        else
            pill.BackgroundColor3 = THEME.bgRow
            if gradObj then gradObj:Destroy() ; gradObj = nil end
            if not strokeObj then strokeObj = stroke(pill, THEME.border, 1) end
        end
        TweenService:Create(knob, TWEEN_FAST, {
            Position = v and UDim2.new(0, 18, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
        }):Play()
    end

    pill.MouseButton1Click:Connect(function()
        apply(not state)
        callback(state)
    end)

    return apply
end

